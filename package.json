{
	"name": "espe-editor",
	"version": "2026.1.1",
	"description": "ESPE rich-text editor for React-Native",
	"source": "index.tsx",
	"main": "index.tsx",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build:web": "cd web-editor && yarn install && yarn build",
		"bump": "standard-version --no-git-tag-version && git push origin && git push origin v$(node -p \"require('./package.json').version\") && echo \"Package $(node -p \"require('./package.json').name\") has been updated to version $(node -p \"require('./package.json').version\")\""
	},
	"keywords": [
		"react-native",
		"editor",
		"richtext",
		"tiptap",
		"ios",
		"android"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/espe-org/espe-editor.git"
	},
	"author": "Salavat Iskhakov <salavat@projecto.pro> (https://github.com/espe-org)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/espe-org/espe-editor/issues"
	},
	"homepage": "https://github.com/espe-org/espe-editor#readme",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"peerDependencies": {
		"react": "*",
		"react-native": "*",
		"react-native-webview": "*"
	},
	"dependencies": {
		"@10play/tentap-editor": "^1.0.1"
	},
	"devDependencies": {
		"@types/react": "19.2.0",
		"react": "19.2.3",
		"react-native": "0.85.3",
		"react-native-webview": "^13.16.1",
		"standard-version": "9.5.0",
		"typescript": "5.9.3"
	},
	"packageManager": "yarn@3.6.4"
}
