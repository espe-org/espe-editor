{
  "name": "espe-editor-web-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Custom tentap WebView editor bundle with table support. Built into a single inlined HTML and emitted as ../src/generated/editorHtml.ts (passed to useEditorBridge as customSource).",
  "scripts": {
    "build": "vite build && node scripts/emit-html.mjs"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@tiptap/extension-table": "^3.23.5",
    "@tiptap/extension-table-cell": "^3.23.5",
    "@tiptap/extension-table-header": "^3.23.5",
    "@tiptap/extension-table-row": "^3.23.5",
    "@tiptap/react": "^3.23.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.1.0"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
